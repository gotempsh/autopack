cabal-version:      2.4
name:               haskell-api
version:            1.0.0
synopsis:           autopack Haskell example
build-type:         Simple

executable haskell-api
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base >=4.14 && <5
                    , bytestring
                    , network
    default-language: Haskell2010
    ghc-options:      -O2 -threaded -rtsopts
